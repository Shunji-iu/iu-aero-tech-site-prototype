---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

const blogs = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title={"ブログ | 航空技術研究会"} description={"茨城大学航空技術研究会の活動報告やイベント情報を掲載しています。"} ogTitle={"ブログ | 航空技術研究会"} ogDescription={"航空技術研究会の活動報告やイベント情報をお届けします。"}>
<!-- 共通ヘッダー -->
    

    <!-- ====================
         ブログ
         ==================== -->

    <main class="blog-page">

        <div class="blog-header">

            <p class="blog-subtitle">
                BLOG
            </p>

            <h1>ブログ</h1>

            <p>
                航空技術研究会の活動の様子を紹介します。
            </p>

        </div>

        <div id="blog-list">
            {blogs.map(async (blog) => {
                const { Content } = await render(blog);
                const date = blog.data.date.toLocaleDateString("ja-JP", {
                    year: "numeric",
                    month: "long",
                    day: "2-digit",
                    timeZone: "UTC"
                });

                return (
                <article
                    class="blog-card"
                    id={blog.id}
                >
                    <img src={blog.data.image} alt={blog.data.title} class="blog-image" loading="lazy" decoding="async">
                    <div class="blog-body">
                        <p class="blog-date">{date}</p>
                        <h2 class="blog-title">{blog.data.title}</h2>
                        <p class="blog-summary">{blog.data.summary}</p>
                        <p class="read-more">タップして続きを読む →</p>
                    </div>
                    <template id={`blog-content-${blog.id}`}>
                        <div class="modal-text"><Content /></div>
                    </template>
                </article>
                );
            })}
        </div>

        <div id="pagination" class="pagination"></div>

        <div id="blog-modal" class="blog-modal">

            <div class="blog-modal-content">

                <button class="close-modal">
                    ×
                </button>

                <div id="modal-body"></div>

            </div>

        </div>

    </main>


    <!-- 共通フッター -->
    
    
    <script is:inline src="blog.js"></script>
</BaseLayout>
