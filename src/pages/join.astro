---
import BaseLayout from "../layouts/BaseLayout.astro";
import scheduleData from "../data/schedule-data.json";
---

<BaseLayout title={"入会希望の方へ | 航空技術研究会"} description={"茨城大学航空技術研究会への入会を希望する方へ向けて、活動内容や参加方法をご案内します。"} ogTitle={"入会希望の方へ | 航空技術研究会"} ogDescription={"航空技術、ものづくり、飛行機やドローンに興味がある方へ、入会方法をご案内します。"}>
<!-- 共通ヘッダー -->
    


    <main class="join-page">

        <!-- ====================
             ページタイトル
             ==================== -->

        <div class="join-header">

            <p class="join-subtitle">JOIN US</p>

            <h1>入会希望の方へ</h1>

            <p>
                航空技術研究会では、一緒に活動する仲間を募集しています。
            </p>

        </div>


        <!-- ====================
             メンバー募集中
             ==================== -->

        <section class="join-section">

            <div class="join-lead">

                <p class="join-label">
                    MEMBER WANTED
                </p>

                <h2>
                    メンバー募集中！
                </h2>

                <p>
                    茨城大学の
                    <strong>すべての学年・学部の学生</strong>
                    が対象です！
                </p>

            </div>

        </section>


        <!-- ====================
             こんな人におすすめ
             ==================== -->

        <section class="join-section">

            <h2 class="section-title">
                こんな方におすすめ
            </h2>

            <div class="join-points">

                <div class="join-point">
                    <span class="join-number">01</span>
                    <p>航空技術に興味のある方</p>
                </div>

                <div class="join-point">
                    <span class="join-number">02</span>
                    <p>電子工作・プログラミングに興味のある方</p>
                </div>

                <div class="join-point">
                    <span class="join-number">03</span>
                    <p>ドローンやEPP航空機の操縦に挑戦したい方</p>
                </div>

                <div class="join-point">
                    <span class="join-number">04</span>
                    <p>地域貢献やイベント企画に参加したい方</p>
                </div>

            </div>

        </section>


        <!-- ====================
             見学・体験会
             ==================== -->

        <section class="join-section">

            <div class="visit-box">

                <p class="visit-label">
                    VISIT & EXPERIENCE
                </p>

                <h2>
                    見学・体験会も随時受付中！
                </h2>

                <p>
                    航空技術研究会の活動に興味がある方は、
                    ぜひ一度見学に来てください。
                </p>

                <p>
                    実際の活動を見たり、メンバーと一緒に
                    ドローンなどを体験したりすることができます。
                </p>

                <p class="visit-message">
                    DM(ダイレクトメッセージ)またはメールよりお気軽にご連絡ください。
                </p>

                <a href="contact.html" class="join-contact-button">
                    連絡はこちらから
                </a>

            </div>

        </section>


        <!-- ====================
             活動スケジュール
             ==================== -->

        <section class="join-section">

            <div class="section-heading">

                <p class="section-subtitle">
                    SCHEDULE
                </p>

                <h2 class="section-title">
                    体験会・サークル活動スケジュール
                </h2>

            </div>


            <div class="schedule-list" id="schedule-list">
                {scheduleData.map((item) => (
                    <div class="schedule-item">
                        <div class="schedule-date">
                            <span>{item.year}</span>
                            {item.date}
                        </div>
                        <div class="schedule-content">
                            <span class="schedule-category">{item.category}</span>
                            <h3>{item.title}</h3>
                            <p>{item.description}</p>
                            <p class="schedule-place">📍 {item.place}</p>
                        </div>
                    </div>
                ))}
            </div>

        </section>


        <!-- ====================
             最後の案内
             ==================== -->

        <section class="join-bottom">

            <h2>
                航空技術研究会で<br>
                一緒に活動しませんか？
            </h2>

            <p>
                少しでも興味があれば、まずは見学からでも大歓迎です。
            </p>

            <a href="contact.html" class="join-contact-button">
                お問い合わせはこちら
            </a>
        </section>
    </main>

    <!-- 共通フッター -->
    
    
</BaseLayout>
