---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const blogData = (await getCollection("blog")).map((blog) => ({
    id: blog.id,
    title: blog.data.title,
    date: blog.data.date.toLocaleDateString("ja-JP", {
        year: "numeric",
        month: "long",
        day: "2-digit",
        timeZone: "UTC"
    }),
    text: `${blog.data.summary} ${blog.body}`
}));
---

<BaseLayout title={"検索 | 航空技術研究会"} description={"茨城大学航空技術研究会ウェブサイト内を検索します。"} ogTitle={"検索 | 航空技術研究会"} ogDescription={"航空技術研究会ウェブサイト内を検索します。"} robots={"noindex, follow"}>
<!-- 共通ヘッダー -->
    


    <main class="search-page">

        <div class="search-header">

            <p class="search-subtitle">
                SEARCH
            </p>

            <h1>サイト内検索</h1>

        </div>


        <div class="search-result-area">

            <p id="search-message"></p>

            <div id="search-filter">

                <button class="search-filter-button active"
                        data-category="all">
                    すべて
                </button>

                <button class="search-filter-button"
                        data-category="活動内容">
                    活動内容
                </button>

                <button class="search-filter-button"
                        data-category="ブログ">
                    ブログ
                </button>

                <button class="search-filter-button"
                        data-category="FAQ">
                    FAQ
                </button>

                <button class="search-filter-button"
                        data-category="入会案内">
                    入会案内
                </button>

            </div>

            <div id="search-results"></div>

        </div>

    </main>


    <!-- 共通フッター -->
    


    <script
        is:inline
        type="application/json"
        id="blog-data"
        set:html={JSON.stringify(blogData).replace(/</g, "\\u003c")}
    ></script>
    <script is:inline src="search-data.js"></script>
    
    <script is:inline src="search.js"></script>
</BaseLayout>
