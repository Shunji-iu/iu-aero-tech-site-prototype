---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={"体験会のご案内 | 航空技術研究会"} description={"茨城大学航空技術研究会の体験会や学園祭イベントについてご案内します。"} ogTitle={"体験会のご案内 | 航空技術研究会"} ogDescription={"航空技術研究会の体験会や学園祭イベントの情報をご案内します。"}>
<!-- 共通ヘッダー -->
    

    <main class="trial-page">

        <!-- メインビジュアル -->
        <section class="trial-hero">

            <h1>✈ 体験会開催！</h1>

            <p>
                飛行機・ドローンに興味がある方へ<br>
                トイドローンを操縦してみませんか？<br>
                こうがく祭では〇〇〇〇の販売も行います！
            </p>

            <div class="trial-entry-buttons">

                <a href="404.html"
                   class="trial-entry-button"
                   target="_blank"
                   rel="noopener noreferrer">
                    こうがく祭 ホームページはこちら
                </a>
                <a href="404.html"
                   class="trial-entry-button"
                   target="_blank"
                   rel="noopener noreferrer">
                    　茨苑祭　 ホームページはこちら
                </a>

            </div>

        </section>


        <!-- イベント概要 -->
        <section class="trial-section">

            <h2>開催概要</h2>

            <div class="trial-grid">

                <div class="trial-card">

                    <h3>📅 日時</h3>

                    <p>
                        こうがく祭：11月07日（土）　10:00〜16:00<br><br>
                        茨苑祭：11月14日（土）～15日（日）　09:30～17:00
                    </p>

                </div>

                <div class="trial-card">

                    <h3>📍 場所</h3>

                    <p>
                        こうがく祭：茨城大学 日立キャンパス<br><br>
                        茨苑祭：茨城大学 水戸キャンパス
                    </p>

                </div>

                <div class="trial-card">

                    <h3>💰 費用</h3>

                    <p>
                        無料
                    </p>

                </div>

                <div class="trial-card">

                    <h3>👤 対象</h3>

                    <p>
                        学内外全ての方
                    </p>

                </div>

            </div>

        </section>


        <!-- 内容 -->
        <section class="trial-section">

            <h2>体験できること</h2>

            <div class="trial-grid">

                <div class="trial-card">

                    <h3>🚁 トイドローン</h3>

                    <p>
                        実際に操縦できます
                    </p>

                </div>

                <div class="trial-card">

                    <h3>🚀 空撮用ドローン</h3>

                    <p>
                        機体紹介・展示
                    </p>

                </div>

                <div class="trial-card">

                    <h3>✈ RC飛行機</h3>

                    <p>
                        機体紹介・展示
                    </p>

                </div>

                <div class="trial-card">

                    <h3>🛠 その他製作物</h3>

                    <p>
                        様々な製作物を展示します
                    </p>

                </div>

            </div>

        </section>


        <!-- 持ち物 -->
        <section class="trial-section">

            <h2>持ち物</h2>

            <ul class="trial-list">

                <li>特別な持ち物は不要です</li>

            </ul>

        </section>

    </main>

    

    
</BaseLayout>
