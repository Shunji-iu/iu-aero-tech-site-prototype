---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={"よくある質問 | 航空技術研究会"} description={"茨城大学航空技術研究会への参加や活動見学、活動内容についてのよくある質問に回答しています。"} ogTitle={"よくある質問 | 航空技術研究会"} ogDescription={"活動見学や参加方法など、航空技術研究会についてのよくある質問を紹介します。"}>
<!-- 共通ヘッダー -->
    

    <!-- ====================
         よくある質問
         ==================== -->
    <main class="faq-page">

        <div class="faq-header">

            <p class="faq-subtitle">FAQ</p>

            <h1>よくある質問</h1>

            <p>
                航空技術研究会について、よくいただく質問をまとめています。
            </p>

        </div>

        <div class="faq-list">

            <!-- 質問1 -->
            <details class="faq-item">
                <summary>
                    <span class="faq-q">Q</span>
                    航空技術研究会には、どの学部・学年から参加できますか？
                </summary>
                <div class="faq-answer">
                    <span class="faq-a">A</span>
                    <p>
                        茨城大学のすべての学年・学部の学生が参加できます。
                        航空技術に興味がある方はもちろん、
                        ドローン、ロケット、電子工作、プログラミングなどに
                        興味がある方も大歓迎です。
                    </p>
                </div>
            </details>

            <!-- 質問2 -->
            <details class="faq-item">
                <summary>
                    <span class="faq-q">Q</span>
                    興味があるのですが、いきなり入会しなくても見学できますか？
                </summary>
                <div class="faq-answer">
                    <span class="faq-a">A</span>
                    <p>
                        もちろんです。見学や体験会も随時受け付けています。
                        実際の活動を見てから入会を決めることもできますので、
                        少しでも興味があればお気軽にDMよりお問い合わせください。
                    </p>
                </div>
            </details>

            <!-- 質問3 -->
            <details class="faq-item">
                <summary>
                    <span class="faq-q">Q</span>
                    入会後に用意しなければならないものはありますか？
                </summary>
                <div class="faq-answer">
                    <span class="faq-a">A</span>
                    <p>
                        入会後に各自でご購入・ご用意いただく物品等はありません。<br>なお、2年次以降は活動費として年間3,000円をいただいております。
                    </p>
                </div>
            </details>


        </div>

        <!-- お問い合わせへの案内 -->
        <div class="faq-contact">

            <h2>その他の質問はこちらから</h2>

            <p>
                掲載されていない質問がありましたら、
                お気軽にお問い合わせください。
            </p>

            <a href="contact.html">
                お問い合わせ
            </a>
        </div>
    </main>

    <!-- 共通フッター -->
    
    
</BaseLayout>
