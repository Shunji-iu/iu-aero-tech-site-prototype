---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={"ミーティング | 航空技術研究会"} description={"茨城大学航空技術研究会のミーティングについて紹介します。活動方針や予定を確認できます。"} ogTitle={"ミーティング | 航空技術研究会"} ogDescription={"航空技術研究会のミーティングや活動方針について紹介します。"}>
<!-- 共通ヘッダー -->
    


    <main class="join-page meeting-page">

        <!-- ====================
             ページタイトル
             ==================== -->

        <div class="join-header">

            <p class="join-subtitle">REGULAR MEETING</p>

            <h1>定例ミーティング</h1>

            <p>
                茨城大学航空技術研究会の会員のみが参加できます。それ以外の方はご遠慮ください。
            </p>

        </div>


        <!-- ====================
             ミーティングにアクセス
             ==================== -->

        <section class="join-section">

            <div class="join-lead">

                <p class="join-label">
                    JOIN THE MEETING
                </p>

                <h2 class="meeting-join-title">
                    <a href="404.html" class="join-contact-button">ミーティングに参加</a>
                </h2>

                <p>
                    毎週
                    <strong>●曜日</strong>
                    ●●：●●～●●：●●
                </p>

            </div>

        </section>
    </main>

    <!-- 共通フッター -->
    
    
</BaseLayout>
